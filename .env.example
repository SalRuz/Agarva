# Server (Node / PM2 / Docker)
PORT=3001
# Generate a long random value; it is shared only by the game server and bot.
GAME_API_SECRET=replace-with-a-long-random-secret

# Встроенный Telegram-бот стартует вместе с сервером при значении 1.
TELEGRAM_BOT_ENABLED=1
TELEGRAM_BOT_TOKEN=8657222247:AAG2Yg6gGE9tT1PcoMqF8y4wmOsbrKC_CkE
# Числовой Telegram user ID разработчика (команды выгрузки/загрузки БД в боте).
TELEGRAM_DEV_ID=1170970828
# Необязательно: внешний адрес API. Пусто = http://127.0.0.1:PORT (рекомендуется на Timeweb).
GAME_API_URL=

# Client build-time override (optional). Leave empty to use same-origin wss://host/ws in production.
# VITE_WS_URL=wss://your-domain.example/ws
